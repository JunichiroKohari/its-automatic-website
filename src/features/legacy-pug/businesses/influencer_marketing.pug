doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="light")
    title インフルエンサーマーケティング事業 | 株式会社 It's Automatic
    meta(name="description" content="reveal.jsを使ったスライド形式のインフルエンサーマーケティング紹介ページ。キャスティングから投稿まで一気通貫で支援します。")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/dist/reset.css")
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/dist/reveal.css")
  body.influencer-slide-page
    .deck-toolbar
      a.deck-toolbar__brand(href="index.html")
        img(src="../../img/logo-primary.png" alt="It's Automatic")
      .deck-toolbar__actions
        a.deck-chip(href="#/0") TOP
        a.deck-chip(href="#/1") 概要
        a.deck-chip(href="#/2") 紹介
        a.deck-chip(href="#/3") 流れ
        a.deck-chip(href="#/4") メリット
        a.deck-button(href="index.html#contact") お問い合わせ

    .reveal
      .slides
        section(data-background-gradient="linear-gradient(140deg, #0d2b31 0%, #143f46 42%, #c8923d 100%)")
          .hero-slide.slide-anim
            .hero-slide__copy
              p.deck-kicker INFLUENCER MARKETING SERVICE
              h1
                | 発信力を、
                br
                | 売上につながる
                br
                | 施策へ。
              p.hero-slide__lead TikTok・Instagramを中心に、影響力あるインフルエンサーを活用したPR支援を提供します。企業とクリエイターの間に入り、企画から投稿まで実行します。
              .hero-slide__metrics
                .metric-card
                  strong 340万人規模
                  span SNSネットワーク総フォロワー
                .metric-card
                  strong 2大SNS中心
                  span TikTok / Instagram
                .metric-card
                  strong Cast to Post
                  span キャスティングから投稿まで対応
            .hero-slide__visual
              img(src="../../img/influencer-thumbnail.png" alt="インフルエンサーマーケティングのイメージ")

        section(data-background-gradient="linear-gradient(180deg, #f8f0df 0%, #fefcf8 100%)")
          .slide-shell.slide-anim
            p.deck-kicker 1. サービス概要
            h2.slide-title 企業とインフルエンサーをつなぐ、実行型のPR支援。
            p.slide-lead SNS上で影響力のあるインフルエンサーを活用し、認知拡大から購買訴求まで支援します。単なる投稿依頼ではなく、成果に近い導線設計を重視します。
            .overview-grid
              each point, index in servicePoints
                article.glass-card
                  .card-index 0#{index + 1}
                  p= point
            .model-row
              each item, index in serviceModel
                .model-row__item(class=`model-row__item--${item.tone}`)
                  strong= item.title
                  span= item.text

        section
          section(data-background-gradient="linear-gradient(140deg, #122f36 0%, #0e2329 100%)")
            .slide-shell.slide-shell--dark.slide-anim
              p.deck-kicker 2. インフルエンサーご紹介
              h2.slide-title 実績あるクリエイターを起点に、商材と相性のよい訴求を設計します。
              p.slide-lead 資料掲載の代表例を、縦スライドで順に閲覧できる構成にしています。
              .creator-intro
                .creator-intro__stat
                  strong 2名の代表クリエイター
                  span 美容・ファッション・ライフスタイル領域に強み
                .creator-intro__stat
                  strong 大手ブランド実績あり
                  span タイアップ経験を前提に提案可能

          each creator in creators
            section(data-background-gradient="linear-gradient(145deg, #fff9ee 0%, #f5ebd6 100%)")
              .slide-shell.creator-slide.slide-anim
                .creator-slide__identity
                  .creator-avatar= creator.name.slice(0, 1)
                  .creator-head
                    p.deck-kicker= creator.handle
                    h2.slide-title= creator.name
                    p.creator-followers= creator.followers
                    ul.platform-pills
                      each platform in creator.platforms
                        li= platform
                .creator-slide__body
                  .creator-copy
                    ul.creator-points
                      each point, index in creator.strengths
                        li= point
                  .brand-cloud
                    each brand, index in creator.brands
                      span.brand-chip= brand

        section(data-background-gradient="linear-gradient(180deg, #f9f3e7 0%, #fffdf9 100%)")
          .slide-shell.slide-anim
            p.deck-kicker 3. サービスの流れ
            h2.slide-title 初回相談から投稿まで、進行を一本化します。
            .timeline
              each step, index in flow
                article.timeline-step
                  .timeline-step__num= step.number
                  h3= step.title
                  p= step.text
            .price-note
              strong PR費用の目安
              p TikTokは最低30万円から、Instagramは最低15万円から対応可能です。
              p 一般相場の目安は、各SNSフォロワー数 × 1.0円〜1.5円 + 仲介手数料20%です。

        section(data-background-gradient="linear-gradient(140deg, #12353b 0%, #0a1d22 100%)")
          .slide-shell.slide-shell--dark.slide-anim
            p.deck-kicker 4. 御社のメリット
            h2.slide-title 広告出稿だけでは得にくい、自然な信頼獲得につながります。
            .benefit-grid
              each benefit, index in benefits
                article.benefit-card
                  .benefit-card__num= benefit.number
                  h3= benefit.title
                  p= benefit.text
            .closing-cta
              p 美容、ファッション、ライフスタイル、トラベル領域を中心に、貴社商材とターゲットに合う起用案をご提案します。
              .closing-cta__actions
                a.deck-button(href="index.html#contact") お問い合わせ
                a.deck-button.deck-button--ghost(href="index.html#products") BUSINESSへ戻る

    script(src="https://cdn.jsdelivr.net/npm/reveal.js@4.6.1/dist/reveal.js")
