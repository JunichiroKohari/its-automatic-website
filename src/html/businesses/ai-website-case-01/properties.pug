              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="2ldk")
                | 2LDK
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="3ldk")
                | 3LDK
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="4ldk-plus")
