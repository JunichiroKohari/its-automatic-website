doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title
      | 物件一覧 | 小針不動産株式会社
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600;700&family=Noto+Sans+JP:wght@300;400;500&display=swap", rel="stylesheet")
    link(rel="stylesheet", href="assets/css/common.css")
    link(rel="stylesheet", href="assets/css/properties.css")
  body(class="case-site case-site-page case-site-properties")
    nav
      a(href="index.html", class="nav-logo")
        | 小針不動産株式会社
      ul(class="nav-links")
        li
          a(href="index.html#services")
            | サービス
        li
          a(href="index.html#flow")
            | 売買の流れ
        li
          a(href="properties.html")
            | 物件情報
        li
          a(href="team.html")
            | スタッフ紹介
        li
          a(href="index.html#contact", class="nav-cta")
            | 無料相談
    div(class="page-header")
      div(class="page-header-inner")
        div(class="breadcrumb")
          a(href="index.html")
            | ホーム
          span
            | ›
          span(style="color: rgba(255,255,255,0.6);")
            | 物件一覧
        h1
          | 物件一覧
        p
          | こだわりの条件で、あなたにぴったりの物件を見つけましょう。
    div(class="main-content")
      aside(class="sidebar")
        div(class="filter-card")
          div(class="filter-title")
            | 絞り込み
            button(class="filter-clear")
              | クリア
          div(class="filter-section")
            h4
              | 物件種別
            div(class="filter-chips")
              button(class="chip active", type="button", onclick="toggleChip(this)", data-filter-group="category", data-filter-value="")
                | すべて
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="category", data-filter-value="一戸建て")
                | 一戸建て
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="category", data-filter-value="マンション")
                | マンション
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="category", data-filter-value="土地")
                | 土地
          div(class="filter-section")
            h4
              | 価格帯（万円）
            div(class="price-range")
              div(class="price-row")
                input(id="priceMinInput", type="number", placeholder="下限", min="0", step="100")
                span
                  | 〜
                input(id="priceMaxInput", type="number", placeholder="上限", min="0", step="100")
          div(class="filter-section")
            h4
              | エリア
            div(class="filter-chips")
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="area", data-filter-value="東京都")
                | 東京都
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="area", data-filter-value="神奈川県")
                | 神奈川県
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="area", data-filter-value="埼玉県")
                | 埼玉県
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="area", data-filter-value="千葉県")
                | 千葉県
          div(class="filter-section")
            h4
              | 間取り
            div(class="filter-chips")
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="under-1ldk")
                | 1LDK以下
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="2ldk")
                | 2LDK
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="3ldk")
                | 3LDK
              button(class="chip", type="button", onclick="toggleChip(this)", data-filter-group="sidebar-layout", data-filter-value="4ldk-plus")
                | 4LDK以上
          div(class="filter-section")
            h4
              | こだわり条件
            div(class="filter-check")
              label(class="check-item")
                input(id="filterWalk10", type="checkbox", data-filter-flag="walk10")
                span
                  | 駅徒歩10分以内
              label(class="check-item")
                input(id="filterAge10", type="checkbox", data-filter-flag="age10")
                span
                  | 築10年以内
              label(class="check-item")
                input(id="filterParking", type="checkbox", data-filter-flag="parking")
                span
                  | 駐車場あり
              label(class="check-item")
                input(id="filterSouth", type="checkbox", data-filter-flag="southFacing")
                span
                  | 南向き
              label(class="check-item")
                input(id="filterCorner", type="checkbox", data-filter-flag="corner")
                span
                  | 角部屋・角地
              label(class="check-item")
                input(id="filterRenovated", type="checkbox", data-filter-flag="renovated")
                span
                  | リフォーム済み
      div
        div(class="listing-header reveal")
          div(class="listing-header-main")
            div(class="result-count")
              strong
                | 18
              | 件の物件が見つかりました
            select(class="sort-select")
              option(value="newest")
                | 並び替え：新着順
              option(value="price-asc")
                | 価格が安い順
              option(value="price-desc")
                | 価格が高い順
              option(value="area-desc")
                | 面積が広い順
              option(value="age-asc")
                | 築年数が新しい順
          div(style="display:flex;gap:0.8rem;align-items:center;")
            div(class="view-toggles")
              button(class="view-btn active", id="gridBtn", onclick="setView('grid')")
                svg(viewbox="0 0 24 24")
                  rect(x="3", y="3", width="7", height="7")
                  rect(x="14", y="3", width="7", height="7")
                  rect(x="3", y="14", width="7", height="7")
                  rect(x="14", y="14", width="7", height="7")
              button(class="view-btn", id="listBtn", onclick="setView('list')")
                svg(viewbox="0 0 24 24")
                  line(x1="8", y1="6", x2="21", y2="6")
                  line(x1="8", y1="12", x2="21", y2="12")
                  line(x1="8", y1="18", x2="21", y2="18")
                  line(x1="3", y1="6", x2="3.01", y2="6")
                  line(x1="3", y1="12", x2="3.01", y2="12")
                  line(x1="3", y1="18", x2="3.01", y2="18")
        div(class="prop-grid", id="propGrid")
        div(class="pagination reveal", id="pagination")

    include _site-footer.pug
    script(src="assets/js/properties-listing.js", data-case-script="properties-listing")
