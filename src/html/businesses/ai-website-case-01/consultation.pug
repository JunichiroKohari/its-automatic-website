    script
      .

            // ── Chip toggle (multi select)
            function toggleChip(el) { el.classList.toggle('active'); }

            // ── Method select (single)
            function selectMethod(el) {
              document.querySelectorAll('.method-card').forEach(c => c.classList.remove('active'));
              el.classList.add('active');
            }

            // ── Calendar
            const today = new Date();
            let calYear = today.getFullYear();
            let calMonth = today.getMonth();
            let selectedDate = null;

            const WEEKDAYS = ['日','月','火','水','木','金','土'];
            const CLOSED = [0]; // 日曜定休

            function renderCalendar() {
              const title = document.getElementById('calTitle');
              const grid = document.getElementById('calGrid');
              title.textContent = `${calYear}年 ${calMonth + 1}月`;
              grid.innerHTML = '';
              WEEKDAYS.forEach((d, i) => {
                const el = document.createElement('div');
                el.className = 'cal-dow';
                el.textContent = d;
                grid.appendChild(el);
              });
              const first = new Date(calYear, calMonth, 1).getDay();
              const days = new Date(calYear, calMonth + 1, 0).getDate();
              for (let i = 0; i < first; i++) {
                const el = document.createElement('div'); el.className = 'cal-day empty'; grid.appendChild(el);
              }
              for (let d = 1; d <= days; d++) {
                const date = new Date(calYear, calMonth, d);
                const dow = date.getDay();
                const isPast = date < new Date(today.getFullYear(), today.getMonth(), today.getDate());
                const isClosed = CLOSED.includes(dow);
                const isToday = d === today.getDate() && calMonth === today.getMonth() && calYear === today.getFullYear();
                const isSelected = selectedDate && date.toDateString() === selectedDate.toDateString();
                const el = document.createElement('div');
                let cls = 'cal-day';
                if (dow === 0) cls += ' sun';
                if (dow === 6) cls += ' sat';
                if (isPast) cls += ' past';
                else if (isClosed) cls += ' closed';
                if (isToday) cls += ' today';
                if (isSelected) cls += ' selected';
                el.className = cls;
                el.textContent = d;
                if (!isPast && !isClosed) {
                  el.onclick = () => selectDay(date, el);
                }
                grid.appendChild(el);
              }
            }

            function selectDay(date, el) {
              document.querySelectorAll('.cal-day.selected').forEach(d => d.classList.remove('selected'));
              el.classList.add('selected');
              selectedDate = date;
              const wrap = document.getElementById('timeSlotWrap');
              const label = document.getElementById('selectedDateLabel');
              const weekStr = ['日','月','火','水','木','金','土'];
              label.textContent = `${date.getFullYear()}年${date.getMonth()+1}月${date.getDate()}日（${weekStr[date.getDay()]}）の予約可能時間`;
              // Reset time slots
              document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
              wrap.style.display = 'block';
              wrap.scrollIntoView && (wrap.style.scrollMargin = '20px');
            }

            function selectTime(el) {
              if (el.classList.contains('full')) return;
              document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
              el.classList.add('selected');
            }

            function prevMonth() {
              calMonth--; if (calMonth < 0) { calMonth = 11; calYear--; }
              renderCalendar();
            }
            function nextMonth() {
              calMonth++; if (calMonth > 11) { calMonth = 0; calYear++; }
              renderCalendar();
            }

            renderCalendar();

            // ── Steps indicator
            function setStep(n) {
              [1,2,3].forEach(i => {
                const num = document.getElementById(`step${i}-num`);
                const lbl = document.getElementById(`step${i}-label`);
                if (i < n) { num.className = 'step-num done'; lbl.className = 'step-label'; }
                else if (i === n) { num.className = 'step-num active'; lbl.className = 'step-label active'; }
                else { num.className = 'step-num pending'; lbl.className = 'step-label'; }
              });
            }

            // ── Collect form data
            function collectData() {
              const form = document.getElementById('reservationForm');
              const timeSelected = document.querySelector('.time-slot.selected');
              const weekStr = ['日','月','火','水','木','金','土'];
              return {
                lastName:  form.lastName.value.trim(),
                firstName: form.firstName.value.trim(),
                lastKana:  form.lastKana.value.trim(),
                firstKana: form.firstKana.value.trim(),
                tel:       form.tel.value.trim(),
                email:     form.email.value.trim(),
                address:   form.address.value.trim(),
                budget:    form.budget.value,
                message:   form.message.value.trim(),
                types:     [...document.querySelectorAll('.type-chip.active')].map(c => c.textContent.trim()).join('、') || '未選択',
                method:    document.querySelector('.method-card.active h4')?.textContent || '来店相談',
                dateStr:   selectedDate
                  ? `${selectedDate.getFullYear()}年${selectedDate.getMonth()+1}月${selectedDate.getDate()}日（${weekStr[selectedDate.getDay()]}）`
                  : '未選択',
                timeStr:   timeSelected ? timeSelected.textContent : '未選択',
              };
            }

            // ── Build detail rows HTML
            function buildDetailRows(data) {
              const rows = [
                ['お名前',       `${data.lastName} ${data.firstName} 様`],
                ['フリガナ',     `${data.lastKana} ${data.firstKana}`],
                ['電話番号',     data.tel],
                ['メールアドレス', data.email],
                ['現在のご住所', data.address || '—'],
                ['ご相談種別',   data.types],
                ['相談方法',     data.method],
                ['ご希望日',     data.dateStr],
                ['ご希望時間',   data.timeStr],
                ['ご予算',       data.budget || '—'],
                ['ご要望・ご質問', data.message || '—'],
              ];
              return rows.map(([k, v]) =>
                `<div class="complete-detail-row"><span>${k}</span><span>${v}</span></div>`
              ).join('');
            }

            // ── Form submit → show confirm screen
            document.getElementById('reservationForm').addEventListener('submit', function(e) {
              e.preventDefault();
              const data = collectData();
              const privacy = document.getElementById('privacyCheck').checked;

              if (!data.lastName || !data.firstName || !data.tel || !data.email || !privacy) {
                alert('必須項目をすべてご入力の上、プライバシーポリシーにご同意ください。');
                return;
              }

              // Show confirm screen (step 2)
              setStep(2);
              document.getElementById('confirmDetail').innerHTML = buildDetailRows(data);
              document.querySelector('.form-card').style.display = 'none';
              document.getElementById('confirmScreen').style.display = 'block';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            });

            // ── Back to form
            function backToForm() {
              setStep(1);
              document.getElementById('confirmScreen').style.display = 'none';
              document.querySelector('.form-card').style.display = 'block';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // ── Final submit → show complete screen
            function submitFinal() {
              const data = collectData();
              setStep(3);
              document.getElementById('completeDetail').innerHTML = buildDetailRows(data);
              document.getElementById('confirmScreen').style.display = 'none';
              document.getElementById('completeScreen').style.display = 'block';
              window.scrollTo({ top: 0, behavior: 'smooth' });
            }

