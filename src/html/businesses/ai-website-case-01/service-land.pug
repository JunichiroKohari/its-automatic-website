          div(class="support-card reveal reveal-delay-3")
            div(class="support-card-icon")
              svg(viewbox="0 0 24 24")
                path(d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z")
