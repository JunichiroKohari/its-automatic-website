    script
      .

            // ── 営業時間グリッド（今日をハイライト）
            const DAY_NAMES = ['日','月','火','水','木','金','土'];
            const DAY_CLASSES = ['sun','','','','','','sat'];
            const HOURS = [
              { open: false, time: '定休日' },       // 日
              { open: true,  time: '9:00〜18:00' },  // 月
              { open: true,  time: '9:00〜18:00' },  // 火
              { open: true,  time: '9:00〜18:00' },  // 水
              { open: true,  time: '9:00〜18:00' },  // 木
              { open: true,  time: '9:00〜18:00' },  // 金
              { open: true,  time: '9:00〜18:00' },  // 土
            ];

            const todayDow = new Date().getDay();
            const grid = document.getElementById('hoursGrid');
            DAY_NAMES.forEach((name, i) => {
              const h = HOURS[i];
              const isToday = i === todayDow;
              const div = document.createElement('div');
              div.className = 'hours-day' + (h.open ? '' : ' closed') + (isToday ? ' today-col' : '');
              div.innerHTML = `
                <div class="hours-day-name ${DAY_CLASSES[i]}">${name}${isToday ? '<br><span style="font-size:0.58rem;color:var(--gold);letter-spacing:0.05em">今日</span>' : ''}</div>
                <div class="hours-status ${h.open ? '' : 'closed-txt'}">${h.open ? '営業' : '休業'}</div>
                <div class="hours-time">${h.time}</div>
              `;
              grid.appendChild(div);
            });

            // ── Reveal
            const reveals = document.querySelectorAll('.reveal');
            const obs = new IntersectionObserver(entries => {
              entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
            }, { threshold: 0.1 });
            reveals.forEach(el => obs.observe(el));
