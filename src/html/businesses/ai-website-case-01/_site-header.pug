- const headerNavAttributes = typeof siteHeaderNavAttributes !== 'undefined' ? siteHeaderNavAttributes : {}
- const headerLogoHref = typeof siteHeaderLogoHref !== 'undefined' ? siteHeaderLogoHref : 'index.html'
- const headerServicesHref = typeof siteHeaderServicesHref !== 'undefined' ? siteHeaderServicesHref : 'index.html#services'
- const headerFlowHref = typeof siteHeaderFlowHref !== 'undefined' ? siteHeaderFlowHref : 'index.html#flow'
- const headerPropertiesHref = typeof siteHeaderPropertiesHref !== 'undefined' ? siteHeaderPropertiesHref : 'properties.html'
- const headerTeamHref = typeof siteHeaderTeamHref !== 'undefined' ? siteHeaderTeamHref : 'team.html'
- const headerCtaHref = typeof siteHeaderCtaHref !== 'undefined' ? siteHeaderCtaHref : 'consultation.html'

- const headerNavLinkId = typeof siteHeaderNavLinkId !== 'undefined' ? siteHeaderNavLinkId : 'siteNavLinks'
- const headerServicesMenuId = typeof siteHeaderServicesMenuId !== 'undefined' ? siteHeaderServicesMenuId : 'siteServicesSubmenu'

nav(class="site-header")&attributes(headerNavAttributes)
  a(href=headerLogoHref, class="nav-logo", aria-label="小針不動産株式会社 ホーム")
    span(class="nav-logo-text")
      span(class="nav-logo-corp")
        | 株式会社
      span(class="nav-logo-ja")
        | 小針不動産
  button(class="hamburger", type="button", aria-label="メニューを開く", aria-controls=headerNavLinkId, aria-expanded="false")
    span
    span
    span
  ul(class="nav-links", id=headerNavLinkId)
    li(class="nav-item nav-item--services")
      div(class="nav-item-trigger")
        a(href=headerServicesHref)
          | サービス
        button(class="nav-submenu-toggle", type="button", aria-label="サービス一覧を開く", aria-controls=headerServicesMenuId, aria-expanded="false")
          span(class="sr-only")
            | サービス一覧を開く
      ul(class="nav-submenu", id=headerServicesMenuId, aria-label="サービス一覧")
        li
          a(href="service-purchase.html")
            | 住宅購入サポート
        li
          a(href="service-sale.html")
            | 不動産売却
        li
          a(href="service-land.html")
            | 土地売買
        li
          a(href="consultation.html")
            | 無料相談・査定
    li
      a(href=headerFlowHref)
        | 売買の流れ
    li
      a(href=headerPropertiesHref)
        | 物件情報
    li
      a(href=headerTeamHref)
        | スタッフ紹介
    li
      a(href=headerCtaHref, class="nav-cta")
        | 無料相談
script
  .
        (function () {
          const header = document.currentScript?.previousElementSibling;
          if (!header || !header.classList.contains('site-header')) return;

          const menuToggle = header.querySelector('.hamburger');
          const servicesItem = header.querySelector('.nav-item--services');
          const servicesLink = servicesItem?.querySelector('.nav-item-trigger > a');
          const servicesToggle = header.querySelector('.nav-submenu-toggle');

          if (!menuToggle) return;

          const closeServices = () => {
            if (!servicesItem || !servicesToggle) return;
            servicesItem.classList.remove('is-open');
            servicesToggle.setAttribute('aria-expanded', 'false');
          };

          const closeMenu = () => {
            header.classList.remove('is-open');
            document.body.classList.remove('nav-open');
            menuToggle.setAttribute('aria-expanded', 'false');
            closeServices();
          };

          const openMenu = () => {
            header.classList.add('is-open');
            document.body.classList.add('nav-open');
            menuToggle.setAttribute('aria-expanded', 'true');
          };

          menuToggle.addEventListener('click', function () {
            if (header.classList.contains('is-open')) {
              closeMenu();
            } else {
              openMenu();
            }
          });

          if (servicesToggle && servicesItem) {
            const toggleServices = function () {
              const isOpen = servicesItem.classList.toggle('is-open');
              servicesToggle.setAttribute('aria-expanded', String(isOpen));
            };

            servicesToggle.addEventListener('click', function (event) {
              event.preventDefault();
              toggleServices();
            });

            servicesLink?.addEventListener('click', function (event) {
              if (window.innerWidth > 900) return;
              event.preventDefault();
              toggleServices();
            });
          }

          header.querySelectorAll('.nav-links a').forEach(function (link) {
            link.addEventListener('click', function () {
              if (window.innerWidth <= 900) {
                closeMenu();
              }
            });
          });

          window.addEventListener('resize', function () {
            if (window.innerWidth > 900) {
              closeMenu();
            }
          });

          document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
              closeMenu();
            }
          });

          document.addEventListener('click', function (event) {
            if (window.innerWidth > 900) return;
            if (!header.classList.contains('is-open')) return;
            if (header.contains(event.target)) return;
            closeMenu();
          });
        })();
