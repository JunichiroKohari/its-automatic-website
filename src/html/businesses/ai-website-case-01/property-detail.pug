    script
      .

            // Tab switching
            function switchTab(btn, panelId) {
              document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
              document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
              btn.classList.add('active');
              document.getElementById(panelId).classList.add('active');
            }

            // Fav toggle
            function toggleFav() {
              const btn = document.getElementById('favBtn');
              btn.classList.toggle('fav-active');
              btn.querySelector('span') || btn.childNodes;
            }

            // Lightbox
            function openLightbox() { document.getElementById('lightbox').classList.add('open'); }
            function closeLightbox() { document.getElementById('lightbox').classList.remove('open'); }
            document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });

            // Reveal
            const reveals = document.querySelectorAll('.reveal');
            const obs = new IntersectionObserver(entries => {
              entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); } });
            }, { threshold: 0.1 });
            reveals.forEach(el => obs.observe(el));
    script(src="assets/js/property-detail.js", data-case-script="property-detail")
