-
  const strengths = [
    {
      number: '01',
      title: '要件整理から設計まで',
      text: '目的、制約、既存業務を整理し、実装に入れる粒度まで仕様を具体化します。',
    },
    {
      number: '02',
      title: 'Web / API / バッチ開発',
      text: 'フロントエンド、バックエンド、API、業務バッチなど、プロダクトに必要な開発を横断して支援します。',
    },
    {
      number: '03',
      title: 'インフラ・運用も見据えた実装',
      text: 'クラウド、CI/CD、ログ、監視、保守性まで考慮し、長く使えるシステムに整えます。',
    },
  ]

  const process = [
    {
      number: '01',
      title: '初回相談',
      text: '開発したい内容、現在の課題、体制、希望スケジュールを確認します。',
    },
    {
      number: '02',
      title: '支援範囲の整理',
      text: '要件定義、設計、実装、レビュー、運用改善など、必要な役割を明確にします。',
    },
    {
      number: '03',
      title: '開発・改善',
      text: '既存チームと連携しながら、実装と検証を進めます。必要に応じて技術選定も支援します。',
    },
    {
      number: '04',
      title: 'リリース・保守',
      text: 'リリース後の不具合対応、機能追加、運用改善まで継続的に伴走します。',
    },
  ]

  const supportItems = [
    '新規 Web サービス / 業務システムの開発',
    '既存システムの機能追加・改修',
    'API / バッチ / データ処理の実装',
    'クラウド環境・CI/CD・開発基盤の整備',
    'コードレビュー・技術調査・開発チーム支援',
    '短期スポットから継続参画までの相談',
  ]

doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="color-scheme" content="light")
    title システム開発 | 株式会社 It's Automatic
    meta(name="description" content="株式会社 It's Automatic のシステム開発サービス。Webサービス、業務システム、API、インフラまで、弊社エンジニアが御社の開発業務を支援します。")
  body.system-dev-page
    header.system-header
      a.system-header__brand(href="index.html" aria-label="株式会社 It's Automatic トップへ戻る")
        img(src="../../img/logo-primary.png" alt="It's Automatic")
      nav.system-header__nav(aria-label="ページ内ナビゲーション")
        a(href="#support") 支援領域
        a(href="#process") 進め方
        a(href="engineer_skill_sheet.html") エンジニア詳細
        a.system-header__contact(href="index.html#contact") お問い合わせ

    main
      section.system-hero
        .system-hero__inner
          .system-hero__copy
            p.system-kicker SYSTEM DEVELOPMENT
            h1 弊社のソフトウェアエンジニアが御社の開発業務をお助けします
            p.system-hero__lead
              | Webサービス、業務システム、API、インフラ、運用改善まで。
              | 開発現場に入り込み、実装力と設計力の両面からプロジェクトを前に進めます。
            .system-hero__actions
              a.system-button.system-button--primary(href="engineer_skill_sheet.html") 弊社エンジニアの詳細
              a.system-button.system-button--ghost(href="#support" data-scroll-target="#support") 支援領域を見る
          .system-hero__visual(aria-label="システム開発の対応領域")
            img(src="../../img/system-development-thumbnail.svg" alt="システム開発のイメージ")

      section#support.system-section.system-section--paper
        .system-container
          .section-heading
            p.system-kicker WHAT WE DO
            h2 開発の入口から運用まで、必要な部分を柔軟に支援します。
          .support-grid
            each strength in strengths
              article.support-card
                span.support-card__number= strength.number
                h3= strength.title
                p= strength.text
          ul.support-list
            each item in supportItems
              li= item

      section#process.system-section.system-section--dark
        .system-container
          .section-heading.section-heading--dark
            p.system-kicker PROCESS
            h2 相談内容に合わせて、役割と進め方を最短で固めます。
          .process-list
            each step in process
              article.process-step
                .process-step__number= step.number
                .process-step__body
                  h3= step.title
                  p= step.text

      section.system-cta
        .system-container.system-cta__inner
          p.system-kicker ENGINEER PROFILE
          h2 実際に支援するエンジニアのスキル・実績をご確認ください。
          .system-cta__actions
            a.system-button.system-button--primary(href="engineer_skill_sheet.html") 弊社エンジニアの詳細
            a.system-button.system-button--ghost(href="index.html#contact") お問い合わせ

    footer.system-footer
      a(href="index.html#products") BUSINESSへ戻る
      small &copy; 2026 株式会社 It's Automatic. All rights reserved.
